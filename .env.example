# Browser-visible Supabase configuration (public key, never a service-role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_own_key

# Optional server-only settings. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_own_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_a_rotated_service_role_secret
OWNER_EMAILS=owner@example.com
LOVABLE_API_KEY=replace_with_your_server_api_key
GOOGLE_SHEETS_API_KEY=replace_with_your_connected_sheets_key

# GitHub Actions only; configure these as repository secrets, not in local .env.
GOOGLE_SERVICE_ACCOUNT_JSON=
SCHEDULE_SUPABASE_URL=
SCHEDULE_SUPABASE_SERVICE_ROLE_KEY=
